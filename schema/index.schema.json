{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "index",
  "description": "Generated registry/index.json (tool/validator read surface), schema 2. Optional keys are omitted when empty; name only when it differs from id; routable only as false.",
  "type": "object",
  "required": ["schema", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 2},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "category", "activation", "risk", "provides", "description", "path"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"type": "string", "minLength": 1},
          "type": {"enum": ["skill", "guidance", "workflow", "plugin"]},
          "category": {"type": "string"},
          "activation": {"enum": ["always", "contextual", "explicit", "manual", "dependency"]},
          "risk": {"enum": ["low", "medium", "high"]},
          "provides": {"type": "array", "items": {"type": "string"}},
          "intents": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "aliases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
          "phrases": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "requires": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
          "composes_with": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
          "conflicts_with": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
          "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "platforms": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "description": {"type": "string"},
          "path": {"type": "string", "minLength": 1},
          "routable": {"const": false}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"}
  }
}
